# Copia a .env y rellena (nunca subas .env con claves reales).
# Proveedor LLM (ver app/llm/factory.py para valores soportados).
LLM_PROVIDER=gemini
# Opcional: modelo único para todos los proveedores (si el backend lo usa).
# LLM_MODEL=

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional; por defecto gemini-2.0-flash (si no defines LLM_MODEL).
GEMINI_MODEL=gemini-2.0-flash
