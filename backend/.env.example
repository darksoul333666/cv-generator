# Copia a .env y rellena (nunca subas .env con claves reales).
# Proveedor LLM: gemini | ollama
LLM_PROVIDER=ollama
# Opcional: modelo único para todos los proveedores (si el backend lo usa).
LLM_MODEL=cv-optimizer

# Ollama (modelo local en ~/cv-optimizer)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=cv-optimizer

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional; por defecto gemini-2.0-flash (si no defines LLM_MODEL).
GEMINI_MODEL=gemini-2.0-flash
